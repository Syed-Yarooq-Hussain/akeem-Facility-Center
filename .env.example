MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=williams_facility
PORT=3001
# Public WhatsApp number: country code and digits only. Replace the demo number.
VITE_WHATSAPP_NUMBER=491234567890
# Set to the final canonical domain before the production build.
VITE_SITE_URL=https://www.williamsfacility.com
# Run node scripts/create-admin.mjs to generate both values below.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional Search Console HTML verification token (not a Google password).
GOOGLE_SITE_VERIFICATION=
